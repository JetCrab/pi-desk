{
  "name": "@jetcrab/pi-desk-desktop",
  "version": "1.1.2",
  "private": true,
  "description": "Pi Desk native desktop shell",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "typecheck:web": "tsc --noEmit",
    "dev": "tauri dev --target i686-pc-windows-msvc",
    "build": "tauri build --target i686-pc-windows-msvc",
    "build:mac": "tauri build --target universal-apple-darwin",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu --bundles appimage",
    "package:install:start": "node scripts/package-install-start.mjs",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml --target i686-pc-windows-msvc",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --target i686-pc-windows-msvc",
    "check:linux": "cargo check --manifest-path src-tauri/Cargo.toml --target x86_64-unknown-linux-gnu",
    "test:linux": "cargo test --manifest-path src-tauri/Cargo.toml --target x86_64-unknown-linux-gnu"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "typescript": "^5"
  }
}
