{
  "name": "@jetcrab/pi-desk",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JetCrab/pi-desk.git"
  },
  "description": "Pi Desk Web service for the Pi coding agent",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-desk": "bin/pi-desk.js"
  },
  "files": [
    "bin",
    "next.config.ts",
    "package.json",
    "src",
    "temp/build/pi-desk/release/.next",
    "tsconfig.json",
    "tsconfig.base.json"
  ],
  "scripts": {
    "dev": "pnpm run build:plugin-host-runtime && tsx watch --tsconfig tsconfig.json --exclude \"temp/**\" --exclude \"**/node_modules/**\" src/server/l1_entry/node/l1-server.ts --dev",
    "build": "pnpm run build:plugin-host-runtime && next build --webpack",
    "build:plugin-host-runtime": "pnpm --filter @jetcrab/pi-desk-sdk build",
    "start": "node bin/pi-desk.js --no-open",
    "test:package": "node --test tests/l4-pi-desk-package.test.mjs",
    "test:app-websocket": "pnpm build && node --import tsx --test tests/l2-chat-state.test.ts tests/l2-workbench-chat-repository.test.ts tests/l2-workbench-chat.test.ts tests/l2-workbench-layout.test.ts tests/l2-work-session-column-layout.test.ts tests/l2-work-session-update.test.ts tests/l1-app-websocket.test.mjs",
    "lint": "eslint .",
    "lint:production": "eslint . --ignore-pattern \"apps/desktop/**\" --ignore-pattern \"**/tests/**\" --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/*.spec.*\"",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:tests": "next typegen && tsc --noEmit -p tsconfig.tests.json",
    "check:layers": "dependency-cruiser --config dependency-cruiser.cjs \"src/**/*.{ts,tsx,mts,js,mjs}\" \"bin/*.{js,mjs}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm typecheck:tests && pnpm lint && pnpm check:layers && pnpm format:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@jetcrab/pi-desk-sdk": "workspace:^",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.2",
    "jiti": "2.7.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "next": "16.3.1",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.15",
    "react-resizable-panels": "^4.12.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.7",
    "use-stick-to-bottom": "^1.1.6",
    "viewerjs": "^1.11.8",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-tui": "1.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "ai": "^7.0.65",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "fake-indexeddb": "^6.2.5",
    "monaco-editor": "0.56.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.15.0"
}
