# 公网主机、relay TLS 与防火墙由实际部署环境决定；这里不包含生产配置。
# 源码构建使用本地标签；部署发行镜像时改为 ghcr.io/jetcrab/pi-desk-tunnel:<已发布版本>。
PI_DESK_TUNNEL_IMAGE=pi-desk-tunnel:local
PI_DESK_TUNNEL_BIND=0.0.0.0:7001
PI_DESK_TUNNEL_SERVER_KEY=<64位十六进制控制密钥>
PI_DESK_TUNNEL_PUBLIC_HOST=tunnel.example.com
PI_DESK_TUNNEL_IROH_RELAY_URL=https://relay.example.com:8443
# 必须与 relay TOML 的 tls.quic_bind_addr 端口一致。
PI_DESK_TUNNEL_IROH_RELAY_QUIC_PORT=7842
PI_DESK_TUNNEL_IROH_RELAY_TOKEN=<relay准入token>
# 复制 relay.example.toml 到私有配置目录，按实际监听和证书设置调整。
IROH_RELAY_CONFIG_PATH=/home/apps/pi-desk-tunnel/config/relay.toml
IROH_RELAY_CERT_DIR=/home/apps/pi-desk-tunnel/data/certs
RUST_LOG=info
