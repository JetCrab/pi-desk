  "changes": {
    "added": [
      "Linux x86_64 desktop support via AppImage, with automatic Node.js and Pi setup and detection of locally installed Git and Bash. Git and Bash must be installed through the distribution's package manager."
    ],
    "features": [],
    "changed": [
      "Unified website and documentation download listings for Windows, macOS, Linux, and Android, with clear availability indicators.",
      "Windows environment detection and PATH updates no longer require PowerShell, while preserving existing PATH entries and registry value types.",
      "Reduced unnecessary session-file scanning during project discovery, history refreshes, session-message access, and usage-detail loading."
    ],
    "fixed": [
      "Usage details now match sessions by both session ID and project directory and revalidate changed or deleted cached files, preventing incorrect or stale session matches."
    ],
