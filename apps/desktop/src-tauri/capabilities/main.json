{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "HTTP(S) target pages can only invoke the current window chrome bridge.",
  "local": false,
  "remote": { "urls": ["http://*:*", "https://*:*"] },
  "windows": ["browser-*"],
  "permissions": ["window-chrome:allow-bridge"]
}
