{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Desk",
  "version": "1.1.1",
  "identifier": "com.jetcrab.desktop",
  "build": {
    "beforeDevCommand": "pnpm run build:web",
    "beforeBuildCommand": "pnpm run build:web",
    "frontendDist": "../../../temp/build/desktop-web/local"
  },
  "app": {
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "useLocalToolsDir": true,
    "category": "Utility",
    "shortDescription": "轻量原生网页桌面壳",
    "longDescription": "打开指定网页并按需托管前台启动命令的轻量原生桌面壳。",
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Pi Desk"
      }
    }
  }
}
