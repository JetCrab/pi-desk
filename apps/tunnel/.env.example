# 控制服务与 relay 的公开地址必须由实际服务器、DNS 和防火墙配置决定。
PI_DESK_TUNNEL_BIND=0.0.0.0:7001
PI_DESK_TUNNEL_SERVER_KEY=<64位十六进制控制密钥>
PI_DESK_TUNNEL_RELAY_BIND=0.0.0.0:7002
PI_DESK_TUNNEL_PUBLIC_RELAY=tunnel.example.com:7002
PI_DESK_TUNNEL_PUBLIC_HOST=tunnel.example.com
PI_DESK_TUNNEL_PRIVATE_KEY=<Noise私钥>
RUST_LOG=info
